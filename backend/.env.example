# Copy this file to the repository root as .env.
# The README backend command uses --env-file ..\.env

VERIFRAME_UPLOAD_DIR=./runtime/uploads
VERIFRAME_MAX_UPLOAD_BYTES=262144000
VERIFRAME_CORS_ORIGINS=http://localhost:5173

# Optional executable overrides; blank means resolve from PATH.
VERIFRAME_FFMPEG_PATH=
VERIFRAME_FFPROBE_PATH=

# Optional model interpreter/script/checkpoint overrides.
VERIFRAME_XCEPTION_PYTHON=
VERIFRAME_XCEPTION_SCRIPT=
VERIFRAME_XCEPTION_CHECKPOINT=
VERIFRAME_GEND_PYTHON=
VERIFRAME_GEND_SCRIPT=
VERIFRAME_EFFORT_PYTHON=
VERIFRAME_EFFORT_SCRIPT=
VERIFRAME_EFFORT_CHECKPOINT=
VERIFRAME_FAKESTORMER_PYTHON=
VERIFRAME_FAKESTORMER_SCRIPT=

# Optional external Xception evaluation.
VERIFRAME_DEEPFAKEBENCH_ROOT=
VERIFRAME_XCEPTION_EVALUATION_PYTHON=
VERIFRAME_XCEPTION_EVALUATION_SCRIPT=
VERIFRAME_XCEPTION_EVALUATION_DATASET=
VERIFRAME_XCEPTION_EVALUATION_CHECKPOINT=

# Optional inference tuning.
VERIFRAME_MAX_FRAMES=32
VERIFRAME_SAMPLE_FPS=1.0
VERIFRAME_INFERENCE_TIMEOUT_SECONDS=1800
